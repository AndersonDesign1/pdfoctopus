{
  "name": "pdfoctopus",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@pdfoctopus/web",
    "desktop": "turbo run dev --filter=@pdfoctopus/desktop",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
